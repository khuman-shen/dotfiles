    "faq1Question": {
        "message": "1. Hver er þessi framlenging?",
        "description": ""
    },
    "faq1Answer": {
        "message": "Það er til að greina QR kóða sjálfkrafa á vefsíðunum og finna síðan tengla og gagnasnið þeirra. Frekari upplýsingar á <a>https://en.wikipedia.org/wiki/QR_code</a>.",
        "description": ""
    },
    "faq2Question": {
        "message": "2. Hversu marga QR kóða getur það greint?",
        "description": ""
    },
    "faq2Answer": {
        "message": "Sjálfgefið eitt, en þú getur stillt það fyrir meira (í hlutanum hér að ofan).",
        "description": ""
    },
    "faq3Question": {
        "message": "3. Hvað er síða og hvers vegna það er notað hér?",
        "description": ""
    },
    "faq3Answer": {
        "message": "Það veitir kjarnaþjónustu til að greina QR kóða og einnig til að búa til / stjórna nýjum QR kóða, með greiningarþjónustu.",
        "description": ""
    },
    "faq4Question": {
        "message": "4. Eru þessir nýju QR kóðar frá qrcd.org öruggir?",
        "description": ""
    },
    "faq4Answer": {
        "message": "Algjörlega! <a></a> er hýst á öruggum skýjapalli og hannað til að vernda alla þjónustu með 100% ábyrgð.",
        "description": ""
    },
    "faq5Question": {
        "message": "5. Getum við breytt QR kóða eða búið til háþróaðar QR kóða tegundir?",
        "description": ""
    },
    "faq5Answer": {
        "message": "Já! Við erum að skipuleggja næstu útgáfu mjög fljótlega með 20+ frábærum nýjum eiginleikum.",
        "description": ""
    },
    "faq6Question": {
        "message": "6. Hvernig get ég notað þessa QR kóða eða kosti þess?",
        "description": ""
    },
    "faq6Answer": {
        "message": "Það getur notað til ýmissa markaðs- og kynningaraðgerða til að láta notendur skjóta QR kóða og fá markefnið. Frekari upplýsingar á <a></a>.",
        "description": ""
    },
    "faq7Question": {
        "message": "7. Hvað með friðhelgi einkalífsins?",
        "description": ""
