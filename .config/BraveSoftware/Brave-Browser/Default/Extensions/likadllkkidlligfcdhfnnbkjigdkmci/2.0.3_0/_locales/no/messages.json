   "description": {
      "description": "",
      "message": "En chrome-utvidelse for å lese QR-kode fra nettsiden"
   },
   "faq1Answer": {
      "description": "",
      "message": "Det er for automatisk å oppdage QR-koder på nettsidene, og deretter finne lenkene og dataformatene. Finn ut mer på \u003Ca>https://en.wikipedia.org/wiki/QR_code\u003C/a>."
   },
   "faq1Question": {
      "description": "",
      "message": "1. Hva er denne utvidelsen?"
   },
   "faq2Answer": {
      "description": "",
      "message": "Som standard en, men du kan konfigurere den for mer (i avsnittet ovenfor)."
   },
   "faq2Question": {
      "description": "",
      "message": "2. Hvor mange QR-koder kan den oppdage?"
   },
   "faq3Answer": {
      "description": "",
      "message": "Det gir kjernetjenestene for å oppdage QR-koder og også for å opprette/administrere nye QR-koder, med analysetjenester."
   },
   "faq3Question": {
      "description": "",
      "message": "3. Hva er site og hvorfor brukes det her?"
   },
   "faq4Answer": {
      "description": "",
      "message": "Absolutt! \u003Ca>\u003C/a> er vert på den sikrede skyplattformen og designet for å beskytte alle tjenester med 100 % garanti."
   },
   "faq4Question": {
      "description": "",
      "message": "4. Er disse nye QR-kodene fra qrcd.org trygge?"
   },
   "faq5Answer": {
      "description": "",
      "message": "Ja! Vi planlegger å lansere neste versjon veldig snart med 20+ flotte nye funksjoner."
   },
   "faq5Question": {
      "description": "",
      "message": "5. Kan vi redigere QR-koder eller lage avanserte QR-kodetyper?"
   },
   "faq6Answer": {
      "description": "",
      "message": "Den kan brukes til ulike markedsførings- og salgsfremmende aktiviteter for å la brukere raskt skanne QR-koder og få målinnholdet. Finn ut mer på \u003Ca>\u003C/a>."
   },
   "faq6Question": {
      "description": "",
      "message": "6. Hvordan kan jeg bruke disse QR-kodene eller fordelene med det?"
   },
   "faq7Answer": {
      "description": "",
      "message": "Vi spør, leser, lagrer eller behandler ingen form for personopplysninger. Finn ut mer på \u003Ca>\u003C/a>"
   },
   "faq7Question": {
      "description": "",
      "message": "7. Hva med personvern?"
   },
