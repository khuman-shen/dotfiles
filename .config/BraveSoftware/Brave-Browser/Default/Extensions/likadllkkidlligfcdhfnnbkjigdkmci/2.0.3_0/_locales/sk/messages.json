   "description": {
      "description": "",
      "message": "Rozšírenie pre Chrome na čítanie QR kódu z webovej stránky"
   },
   "faq1Answer": {
      "description": "",
      "message": "Slúži na automatickú detekciu QR kódov na webových stránkach a následné nájdenie ich odkazov a dátových formátov. Viac informácií nájdete na \u003Ca>https://en.wikipedia.org/wiki/QR_code\u003C/a>."
   },
   "faq1Question": {
      "description": "",
      "message": "1. Čo je toto rozšírenie?"
   },
   "faq2Answer": {
      "description": "",
      "message": "V predvolenom nastavení jeden, ale môžete ho nakonfigurovať na viac (v časti vyššie)."
   },
   "faq2Question": {
      "description": "",
      "message": "2. Koľko QR kódov dokáže rozpoznať?"
   },
   "faq3Answer": {
      "description": "",
      "message": "Poskytuje základné služby na detekciu QR kódov a tiež na vytváranie/správu nových QR kódov s analytickými službami."
   },
   "faq3Question": {
      "description": "",
      "message": "3. Čo je stránka a prečo sa tu používa?"
   },
   "faq4Answer": {
      "description": "",
      "message": "Absolútne! \u003Ca>\u003C/a> je hosťovaná na zabezpečenej cloudovej platforme a je navrhnutá tak, aby chránila všetky služby so 100% zárukou."
   },
   "faq4Question": {
      "description": "",
      "message": "4. Sú tieto nové QR kódy z qrcd.org bezpečné?"
   },
   "faq5Answer": {
      "description": "",
      "message": "Áno! Už čoskoro plánujeme spustiť ďalšiu verziu s 20+ skvelými novými funkciami."
   },
   "faq5Question": {
      "description": "",
      "message": "5. Môžeme upravovať QR kódy alebo vytvárať pokročilé typy QR kódov?"
   },
   "faq6Answer": {
      "description": "",
      "message": "Môže sa použiť na rôzne marketingové a propagačné aktivity, aby používatelia mohli rýchlo skenovať QR kódy a získať cieľový obsah. Viac informácií nájdete na \u003Ca>\u003C/a>."
   },
   "faq6Question": {
      "description": "",
      "message": "6. Ako môžem použiť tieto QR kódy alebo ich výhody?"
   },
   "faq7Answer": {
      "description": "",
      "message": "Nepýtame sa, nečítame, neukladáme ani nespracovávame žiadne osobné údaje. Viac informácií nájdete na \u003Ca>\u003C/a>"
   },
   "faq7Question": {
      "description": "",
      "message": "7. Ako je to so súkromím?"
   },
