   "description": {
      "description": "",
      "message": "Chromova razširitev za branje kode QR s spletne strani"
   },
   "faq1Answer": {
      "description": "",
      "message": "Namenjen je samodejnemu zaznavanju kod QR na spletnih straneh in nato iskanju povezav in formatov podatkov. Več o tem na \u003Ca>https://en.wikipedia.org/wiki/QR_code\u003C/a>."
   },
   "faq1Question": {
      "description": "",
      "message": "1. Kaj je ta razširitev?"
   },
   "faq2Answer": {
      "description": "",
      "message": "Privzeto enega, vendar ga lahko konfigurirate za več (v zgornjem razdelku)."
   },
   "faq2Question": {
      "description": "",
      "message": "2. Koliko QR kod lahko zazna?"
   },
   "faq3Answer": {
      "description": "",
      "message": "Zagotavlja osnovne storitve za odkrivanje kod QR in ustvarjanje/upravljanje novih kod QR z analitičnimi storitvami."
   },
   "faq3Question": {
      "description": "",
      "message": "3. Kaj je spletno mesto in zakaj je tukaj uporabljeno?"
   },
   "faq4Answer": {
      "description": "",
      "message": "Vsekakor! \u003Ca>\u003C/a> gostuje na varni platformi v oblaku in je zasnovan za zaščito vseh storitev s 100-odstotno garancijo."
   },
   "faq4Question": {
      "description": "",
      "message": "4. Ali so te nove kode QR s qrcd.org varne?"
   },
   "faq5Answer": {
      "description": "",
      "message": "ja! Zelo kmalu nameravamo lansirati naslednjo različico z več kot 20 odličnimi novimi funkcijami."
   },
   "faq5Question": {
      "description": "",
      "message": "5. Ali lahko urejamo kode QR ali ustvarjamo napredne vrste kod QR?"
   },
   "faq6Answer": {
      "description": "",
      "message": "Uporablja se lahko za različne marketinške in promocijske dejavnosti, da uporabnikom omogoči hitro skeniranje QR kod in pridobitev ciljne vsebine. Več o tem na \u003Ca>\u003C/a>."
   },
   "faq6Question": {
      "description": "",
      "message": "6. Kako lahko uporabim te kode QR ali prednosti tega?"
   },
   "faq7Answer": {
      "description": "",
      "message": "Ne sprašujemo, beremo, shranjujemo ali obdelujemo nobenih osebnih podatkov. Več o tem na \u003Ca>\u003C/a>"
   },
   "faq7Question": {
      "description": "",
      "message": "7. Kaj pa zasebnost?"
   },
