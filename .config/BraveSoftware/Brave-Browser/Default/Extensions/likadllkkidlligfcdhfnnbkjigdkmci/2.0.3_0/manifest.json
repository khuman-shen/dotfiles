{
   "action": {
      "default_popup": "popup.html",
      "default_title": "QR Code Reader"
   },
   "background": {
      "service_worker": "service_worker.js",
      "type": "module"
   },
   "commands": {
      "_execute_action": {
         "description": "",
         "suggested_key": {
            "default": "Ctrl+Shift+S",
            "mac": "Command+Shift+S",
            "windows": "Ctrl+Shift+S"
         }
      }
   },
   "default_locale": "en",
   "description": "__MSG_description__",
   "icons": {
      "128": "images/icon.png",
      "16": "images/icon.png",
      "48": "images/icon.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "__MSG_name__",
   "options_ui": {
      "open_in_tab": true,
      "page": "options.html"
   },
   "permissions": [ "tabs", "activeTab", "unlimitedStorage", "storage", "contextMenus", "scripting" ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "2.0.3",
   "web_accessible_resources": [ {
      "matches": [ "\u003Call_urls>" ],
      "resources": [ "scripts/libs/*", "scripts/content.js", "scripts/common.js", "scripts/vendors.js", "scripts/shared.js", "css/*", "images/*" ]
   } ]
}
